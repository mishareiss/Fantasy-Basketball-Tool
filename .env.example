# Copy to `.env` and fill in. The real `.env` is gitignored — never commit cookies or keys.
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
# Consumed by the backend (app.config.Settings) and by Alembic.
DATABASE_URL=postgresql+psycopg://fbb:fbb@localhost:5433/fbb

# Consumed by docker-compose to provision the local Postgres 16 container.
# Keep these in sync with DATABASE_URL above.
POSTGRES_USER=fbb
POSTGRES_PASSWORD=fbb
POSTGRES_DB=fbb
# Host port the container is published on. 5433 avoids clashing with a local
# Postgres install on 5432; keep it in sync with DATABASE_URL.
POSTGRES_PORT=5433

# --- ESPN league access -----------------------------------------------------
# Private-league auth: copy these two cookies from your browser while logged in
# to fantasy.espn.com. They expire periodically and need re-pasting.
ESPN_S2=paste_espn_s2_cookie_here
SWID={PASTE-SWID-COOKIE-HERE}
ESPN_LEAGUE_ID=123456789
ESPN_SEASON=2026

# --- Player ages ------------------------------------------------------------
# The date ages are computed as of. Ages are derived from nba.com birthdates, and are
# deliberately NOT computed from "today": a stored age has to be reproducible between runs and
# correct on draft day. Defaults to Oct 1 of the season ESPN_SEASON starts (ESPN_SEASON=2027
# is the 2026-27 season, so 2026-10-01). Set it explicitly to pin ages to another date.
# AGE_AS_OF=2026-10-01

# --- Frontend ---------------------------------------------------------------
# Backend base URL the Next.js app calls. Must be NEXT_PUBLIC_ to reach the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Optional: CORS ---------------------------------------------------------
# JSON array of origins allowed to call the API. Defaults to the Next dev server.
# CORS_ORIGINS=["http://localhost:3000"]

# --- Future: odds / stats providers (not wired up yet) ----------------------
# BALLDONTLIE_API_KEY=
# THE_ODDS_API_KEY=
